{
  "kind": "singleType",
  "collectionName": "site_settings",
  "info": {
    "singularName": "site-setting",
    "pluralName": "site-settings",
    "displayName": "Website-instellingen",
    "description": "Beheer de belangrijkste teksten en contactgegevens van de website."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "siteName": {
      "type": "string",
      "default": "Oussama El Hajoui"
    },
    "seoTitle": {
      "type": "string"
    },
    "seoDescription": {
      "type": "text"
    },
    "seoKeywords": {
      "type": "json"
    },
    "socialTitle": {
      "type": "string"
    },
    "socialDescription": {
      "type": "text"
    },
    "robotsIndex": {
      "type": "boolean",
      "default": true
    },
    "robotsFollow": {
      "type": "boolean",
      "default": true
    },
    "googleSiteVerification": {
      "type": "string"
    },
    "bingSiteVerification": {
      "type": "string"
    },
    "customMetaTags": {
      "type": "component",
      "repeatable": true,
      "component": "shared.meta-tag"
    },
    "heroTitle": {
      "type": "string",
      "required": true,
      "default": "Websites en web apps"
    },
    "heroHighlight": {
      "type": "string",
      "required": true,
      "default": "die presteren."
    },
    "heroText": {
      "type": "text",
      "required": true
    },
    "availability": {
      "type": "string",
      "required": true,
      "default": "Beschikbaar voor nieuwe projecten"
    },
    "stack": {
      "type": "json",
      "required": true
    },
    "homeServices": {
      "type": "component",
      "repeatable": true,
      "component": "shared.home-service"
    },
    "homePrinciples": {
      "type": "component",
      "repeatable": true,
      "component": "shared.summary-card"
    },
    "servicesHero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.page-hero"
    },
    "services": {
      "type": "component",
      "repeatable": true,
      "component": "shared.service"
    },
    "audienceCards": {
      "type": "component",
      "repeatable": true,
      "component": "shared.summary-card"
    },
    "processHero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.page-hero"
    },
    "processSteps": {
      "type": "component",
      "repeatable": true,
      "component": "shared.process-step"
    },
    "collaborationCards": {
      "type": "component",
      "repeatable": true,
      "component": "shared.summary-card"
    },
    "aboutHero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.page-hero"
    },
    "aboutQuote": {
      "type": "text"
    },
    "aboutParagraphs": {
      "type": "json"
    },
    "aboutValues": {
      "type": "component",
      "repeatable": true,
      "component": "shared.summary-card"
    },
    "quoteHero": {
      "type": "component",
      "repeatable": false,
      "component": "shared.page-hero"
    },
    "quoteSteps": {
      "type": "component",
      "repeatable": true,
      "component": "shared.process-step"
    },
    "cta": {
      "type": "component",
      "repeatable": false,
      "component": "shared.call-to-action"
    },
    "footerTagline": {
      "type": "text"
    },
    "contact": {
      "type": "component",
      "repeatable": false,
      "component": "shared.contact-info"
    },
    "tracking": {
      "type": "component",
      "repeatable": false,
      "component": "shared.tracking-settings"
    }
  }
}
